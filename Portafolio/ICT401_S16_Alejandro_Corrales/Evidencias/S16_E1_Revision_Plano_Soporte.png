260\":{\"name\":\"3557098260\",\"rule_id\":\"5ZYpznHQzS8NmvIbJC4fe:100.00:2-5ZYpxIFohIEtWXMABGqWc\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"num_turns\":10},\"is_device_based\":false,\"passed\":true},\"3566525122\":{\"name\":\"3566525122\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":251,\"id_type\":\"userID\",\"value\":{\"include_startup_context\":true,\"architecture\":\"avas\",\"version\":\"v3\",\"model\":\"gpt-live-1.1-codex\",\"recording_enabled\":true,\"use_singleton_orchestrator_thread\":false,\"use_transceiver_service_discovery\":true},\"is_device_based\":false,\"passed\":false},\"3586972587\":{\"name\":\"3586972587\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"prompt\":\"The user provided feedback on a previous completion. Use it to generate a new completion. The output should be a standalone response that reflects the feedback without acknowledging it. Do not mention, suggest, or imply that this is a revision, improvement, or result of feedback. Respond in the same language as the original completion, even if the feedback is in another language. Only switch if the feedback explicitly asks you to translate the completion. Here is the feedback:\\n\"},\"is_device_based\":false,\"passed\":false},\"3595907841\":{\"name\":\"3595907841\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[{\"gate\":\"3097504420\",\"gateValue\":\"true\",\"ruleID\":\"EucMssgnC96MVvOhTzZYO\"}],\"version\":27,\"id_type\":\"userID\",\"value\":{\"show_banner\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"3608673692\":{\"name\":\"3608673692\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"sse_initial_open_timeout_ms\":0,\"sse_first_response_warning_ms\":120000,\"sse_between_bytes_timeout_ms\":60000},\"is_device_based\":false,\"passed\":false},\