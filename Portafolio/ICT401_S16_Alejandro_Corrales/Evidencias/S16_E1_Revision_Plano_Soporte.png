cluyen recíprocamente.</p><!----></div></app-read-more></div><!----><!----><!----><div _ngcontent-txi-c99="" class="highlight-card-note" hidden=""><div _ngcontent-txi-c99="" contenteditable="true" data-placeholder="Take a note..." class="ng-untouched ng-pristine ng-valid"></div><span _ngcontent-txi-c99="" class="highlight-card-note-feedback"></span><div _ngcontent-txi-c99="" class="highlight-card-note-actions"><button _ngcontent-txi-c99="" type="button"> Delete </button></div></div><div _ngcontent-txi-c99="" class="highlight-card-actions"><app-button _ngcontent-txi-c99="" styleclass="highlight-card-icon-button" ngbtooltip="add note" tooltipclass="weava-tooltip" placement="bottom" _nghost-txi-c92=""><button _ngcontent-txi-c92="" type="button" class="button highlight-card-icon-button"><span _ngcontent-txi-c92="" class="button-icon" style="margin-right: 0px;"><img _ngcontent-txi-c99="" src="chrome-extension://cbnaodkpfinfiipjblikofhlhlcickei/assets/images/svg/note-icon.svg"><!----><!----></span><!----><span _ngcontent-txi-c92="" class="button-title"><!----></span></button></app-button><!----><!----><app-button _ngcontent-txi-c99="" styleclass="highlight-card-icon-button" ngbtooltip="copy" tooltipclass="weava-tooltip" placement="bottom" ngxclipboard="" _nghost-txi-c92=""><button _ngcontent-txi-c92="" type="button" class="button highlight-card-icon-button"><span _ngcontent-txi-c92="" class="button-icon" style="margin-right: 0px;"><img _ngcontent-txi-c99="" src="chrome-extension://cbnaodkpfinfiipjblikofhlhlcickei/assets/images/svg/copy-icon.svg"><!----><!----></span><!----><span _ngcontent-txi-c92="" class="button-title"><!----></span></button></app-button><!----><!----><app-button _ngcontent-txi-c99="" styleclass="highlight-card-icon-button" ngbtooltip="delete" tooltipclass="weava-tooltip" placement="bottom" _nghost-txi-c92=""><button _ngcontent-txi-c92="" type="button" class="button highlight-card-icon-button"><span _ngcontent-txi-c92="" class="button-icon" style="margi