JAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/e9d44518f903.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/5164672e6ada.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/18ad5d9adcf9.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/ecc2c5417fa1.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/cfcf364b933e.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/bf937d843c77.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/16a1a1613280.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/1e856fb78cf4.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/82ec7fa60769.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/1e02579e4226.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/fd540a5d2bc3.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/5542d09e1b11.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/338b8d8e11ff.css"><link rel="stylesheet" type="text/css" href="./S16_E1_Revision_Plano_Soporte_files/12e5c98142fc.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><span data-radix-focus-start="" style="display:contents"></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
