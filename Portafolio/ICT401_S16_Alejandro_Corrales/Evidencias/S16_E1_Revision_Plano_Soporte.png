\"version\":24,\"id_type\":\"userID\",\"value\":false},\"4285716042\":{\"name\":\"4285716042\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":57,\"id_type\":\"userID\",\"value\":false},\"4290031608\":{\"name\":\"4290031608\",\"rule_id\":\"3ZFkSu8MibYrruegy7huDD:100.00:1\",\"secondary_exposures\":[],\"version\":80,\"id_type\":\"userID\",\"value\":true}},\"dynamic_configs\":{\"24353602\":{\"name\":\"24353602\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"de\":{\"workspace_admin\":{\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\",\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\"},\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"workspace_owner\":{\"headline\":\"Prüfe die Vorteile deines Workspaces\",\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\"},\"default\":{\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Entdecke ChatGPT Business\"},\"personal_upsell\":{\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\"},\"personal\":{\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\",\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\"}},\"email_selectors\":{\"business_claim\":\"workspace\",\"personal_upsell\":\"personal\",\"parameter\":\"for\"},\"en\":{\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"workspace_owner\":{\"headline\":\"Check your workspace benefits\",\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\"},\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"personal\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\"},\"business_claim\":{\"body\":\"Sign in to the account you use for your Business workspace.\",\"headline\":\"Explore workspace ad credits\"},\"workspace\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"A workspace owner can check Benefits for available offers.\"},\"workspace_admin\":{\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\",\"headline\":\"Help your team find ad credits\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\"}},\"fr\":{\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"},\"workspace_owner\":{\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\",\"headline\":\"Consultez les avantages de votre espace de travail\"},\"business_claim\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\"},\"default\":{\"headline\":\"Découvrez ChatGPT Business\",\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\"},\"workspace_admin\":{\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\",\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\"},\"personal\":{\"headline\":\"Passez à ChatGPT Business avec votre équipe\",\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\"}}},\"is_device_based\":false,\"passed\":false},\"43735283\":{\"name\":\"43735283\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4076966226\",\"gateValue\":\"true\",\"ruleID\":\"3Qrg0sazMu3KFYQ5vbybKp:100.00:12\"}],\"version\":33,\"id_type\":\"userID\",\"value\":{\"text_messaging_enabled\":\"disabled\",\"sentinel_timeout_ms\":250},\"is_device_based\":false,\"passed\":false},\"71832722\":{\"name\":\"71832722\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},\"is_device_based\":false,\"passed\":false},\"73506792\":{\"name\":\"73506792\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":36,\"id_type\":\"userID\",\"value\":{\"max_archive_read_bytes\":838860800,\"max_file_bytes\":268435456,\"max_skill_file_uncompressed_bytes\":268435456,\"max_skill_upload_bytes\":817889280,\"max_skill_total_uncompressed_bytes\":838860800,\"max_arc